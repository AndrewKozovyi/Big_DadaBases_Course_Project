<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Матриця завантаженості приміщень: група типів → тип → місто × рік → квартал → місяць, з розгортанням рівнів і тепловою картою. Варіант 2, звіт 4. Джерело — OLAP-куб «Оренда».</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalCube">
      <DataSourceReference>RentalCube</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>71086d91-a1f3-4243-b4fa-141d83aa8851</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Main">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TypeGroups">
            <Value>=Parameters!TypeGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Years">
            <Value>=Parameters!Years.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH
MEMBER [Measures].[MonthKey] AS [Період].[Місяць].CURRENTMEMBER.MEMBER_KEY
MEMBER [Measures].[QuarterKey] AS [Період].[Квартал].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Орендовані дні], [Measures].[Доступні дні], [Measures].[Дохід від оренди],
        [Measures].[MonthKey], [Measures].[QuarterKey]} ON COLUMNS,
       NonEmpty([Приміщення].[Група типів].[Група типів].MEMBERS
                * [Приміщення].[Тип приміщення].[Тип приміщення].MEMBERS
                * [Приміщення].[Місто].[Місто].MEMBERS
                * [Період].[Рік].[Рік].MEMBERS
                * [Період].[Квартал].[Квартал].MEMBERS
                * [Період].[Місяць].[Місяць].MEMBERS,
                [Measures].[Доступні дні])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TypeGroups, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToSet(@Years, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="TypeGroup">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Приміщення].[Група типів].[Група типів]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PremisesType">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Приміщення].[Тип приміщення].[Тип приміщення]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="City">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Приміщення].[Місто].[Місто]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Рік].[Рік]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quarter">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Квартал].[Квартал]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Місяць].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RentedDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Орендовані дні]" /&gt;</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="AvailableDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Доступні дні]" /&gt;</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Income">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Дохід від оренди]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MonthKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[MonthKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QuarterKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[QuarterKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
