<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Список орендарів з кількістю рахунків, сумами, сплаченим, боргом і простроченнями за період. Варіант 2, звіт 1. Джерело — OLAP-куб «Оренда».</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalCube">
      <DataSourceReference>RentalCube</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>02c46fbd-e0b2-4c88-8d8b-6f7c0316b7d0</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Main">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TenantTypes">
            <Value>=Parameters!TenantTypes.Value</Value>
          </QueryParameter>
          <QueryParameter Name="DateFrom">
            <Value>=Code.DateMember(IIF(Code.BadRange(Parameters!DateFrom.Value, Parameters!DateTo.Value), Parameters!DateTo.Value, Parameters!DateFrom.Value))</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.DateMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
          <QueryParameter Name="MinDebt">
            <Value>=IIF(Parameters!OnlyDebtors.Value, "0", "-1")</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH
MEMBER [Measures].[TaxCode] AS [Орендар].[Орендар].CURRENTMEMBER.PROPERTIES("Податковий код")
MEMBER [Measures].[Phone] AS [Орендар].[Орендар].CURRENTMEMBER.PROPERTIES("Телефон")
SELECT {[Measures].[Кількість рахунків], [Measures].[Сума рахунків], [Measures].[Сплачено], [Measures].[Борг],
        [Measures].[Прострочених рахунків], [Measures].[Макс днів прострочення], [Measures].[Орендованих приміщень],
        [Measures].[TaxCode], [Measures].[Phone]} ON COLUMNS,
       Filter(NonEmpty([Орендар].[Тип орендаря].[Тип орендаря].MEMBERS * [Орендар].[Орендар].[Орендар].MEMBERS,
                       [Measures].[Кількість рахунків]),
              [Measures].[Борг] &gt; StrToValue(@MinDebt))
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TenantTypes, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToMember(@DateFrom, CONSTRAINED) : StrToMember(@DateTo, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="TenantType">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Орендар].[Тип орендаря].[Тип орендаря]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tenant">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Орендар].[Орендар].[Орендар]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoices">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сплачено]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Debt">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Борг]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Overdue">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Прострочених рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MaxOverdueDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Макс днів прострочення]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Premises">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Орендованих приміщень]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TaxCode">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[TaxCode]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Phone">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Phone]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TenantTypes">
      <SharedDataSet>
        <SharedDataSetReference>TenantTypes</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="ParameterCaption">
          <DataField>ParameterCaption</DataField>
