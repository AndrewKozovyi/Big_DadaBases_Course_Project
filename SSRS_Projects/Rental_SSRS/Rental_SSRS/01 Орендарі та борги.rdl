  <Code>
' Член виміру «Період» для MDX: [Період].[Дата].&amp;[yyyyMMdd].
' Дата обмежується діапазоном виміру «Дата» (2021-01-01 ... 2027-12-31), щоб StrToMember(CONSTRAINED) не падав.
Public Function DateMember(ByVal d As Date) As String
    Dim minD As New Date(2021, 1, 1)
    Dim maxD As New Date(2027, 12, 31)
    If d &lt; minD Then d = minD
    If d &gt; maxD Then d = maxD
    Return "[Період].[Дата].&amp;[" &amp; d.ToString("yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture) &amp; "]"
End Function

' Валідація діапазону дат: True, якщо дата початку пізніша за дату завершення
Public Function BadRange(ByVal f As Date, ByVal t As Date) As Boolean
    Return f &gt; t
End Function

' Частка a / b; Nothing, якщо знаменник порожній або нуль
Public Function Ratio(ByVal a As Object, ByVal b As Object) As Object
    If b Is Nothing OrElse IsDBNull(b) Then Return Nothing
    If CDbl(b) = 0 Then Return Nothing
    If a Is Nothing OrElse IsDBNull(a) Then Return 0
    Return CDbl(a) / CDbl(b)
End Function

' Сума елементів масиву (результат LookupSet)
Public Function SumArr(ByVal items As Object()) As Decimal
    Dim s As Decimal = 0
    If items Is Nothing Then Return 0
    For Each it As Object In items
        If Not (it Is Nothing OrElse IsDBNull(it)) Then s += CDec(it)
    Next
    Return s
End Function

' Колір теплової карти для частки 0..1: червоний (&lt;= lo) -&gt; жовтий -&gt; зелений (&gt;= hi)
Public Function Heat(ByVal v As Object, ByVal lo As Double, ByVal hi As Double) As String
    If v Is Nothing OrElse IsDBNull(v) Then Return "White"
    Dim x As Double = (CDbl(v) - lo) / (hi - lo)
    If x &lt; 0 Then x = 0
    If x &gt; 1 Then x = 1
    Dim r, g, b As Integer
    If x &lt; 0.5 Then
        Dim k As Double = x / 0.5
        r = 248 + CInt((255 - 248) * k) : g = 105 + CInt((235 - 105) * k) : b = 107 + CInt((132 - 107) * k)
    Else
        Dim k As Double = (x - 0.5) / 0.5
        r = 255 + CInt((99 - 255) * k) : g = 235 + CInt((190 - 235) * k) : b = 132 + CInt((123 - 132) * k)
    End If
    Return "#" &amp; r.ToString("X2") &amp; g.ToString("X2") &amp; b.ToString("X2")
End Function

' Колір за порогами KPI: &gt;= goal — зелений, &gt;= warn — жовтий, інакше червоний
Public Function KpiColor(ByVal v As Object, ByVal goal As Double, ByVal warn As Double) As String
    If v Is Nothing OrElse IsDBNull(v) Then Return "White"
    If CDbl(v) &gt;= goal Then Return "#E2EFDA"
    If CDbl(v) &gt;= warn Then Return "#FFF2CC"
    Return "#FCE4D6"
End Function
</Code>
