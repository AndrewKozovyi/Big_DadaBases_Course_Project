<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Типи орендарів (параметр)</Description>
  <DataSet Name="TenantTypes">
    <Query>
      <DataSourceReference>RentalCube</DataSourceReference>
      <CommandText>WITH
MEMBER [Measures].[ParameterCaption] AS [Орендар].[Тип орендаря].CURRENTMEMBER.MEMBER_CAPTION
MEMBER [Measures].[ParameterValue] AS [Орендар].[Тип орендаря].CURRENTMEMBER.UNIQUENAME
SELECT {[Measures].[ParameterCaption], [Measures].[ParameterValue]} ON COLUMNS,
       [Орендар].[Тип орендаря].[Тип орендаря].MEMBERS ON ROWS
FROM [Оренда]</CommandText>
    </Query>
    <Fields>
      <Field Name="ParameterCaption">
        <DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[ParameterCaption]&quot; /&gt;</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="ParameterValue">
        <DataField>&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;Field xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xsi:type=&quot;Measure&quot; UniqueName=&quot;[Measures].[ParameterValue]&quot; /&gt;</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>