<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Довідка орендаря: реквізити, борг на сьогодні, договори оренди, рахунки й платежі за кожним договором (підзвіт). Варіант 2, звіт 3. Джерело — сховище RentalDW.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalDW">
      <DataSourceReference>RentalDW</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e4c96e0f-6ab9-439c-9168-05ffe668a31a</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="TenantTypes">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <CommandText>SELECT N'*' AS TenantType, N'Усі типи' AS Name, 0 AS SortOrder
UNION ALL
SELECT DISTINCT TenantType, TenantType, 1 FROM dbo.Dim_Tenant
ORDER BY SortOrder, Name;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TenantType">
          <DataField>TenantType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SortOrder">
          <DataField>SortOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TenantList">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TenantType">
            <Value>=Parameters!TenantType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Search">
            <Value>=Parameters!Search.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP (200) t.TenantID, t.Name + N' (' + t.TaxCode + N')' AS Label
FROM dbo.Dim_Tenant AS t
WHERE (@TenantType = N'*' OR t.TenantType = @TenantType)
  AND (ISNULL(@Search, N'') = N''
       OR t.TaxCode = @Search
       OR t.Name LIKE N'%' + @Search + N'%')
ORDER BY t.Name, t.TenantID;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TenantID">
          <DataField>TenantID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Label">
          <DataField>Label</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Info">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TenantID">
            <Value>=Parameters!TenantID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- реквізити орендаря (Dim_Tenant), кількість договорів (vw_ContractInfo) і поточний борг (Fact_Invoice)
SELECT t.TenantID, t.Name, t.TenantType, t.TaxCode, t.Phone,
       CASE WHEN t.HasEmail = 1 THEN t.Email END AS Email,
       (SELECT COUNT(*) FROM dbo.vw_ContractInfo AS c WHERE c.TenantKey = t.TenantKey) AS ContractsCount,
       (SELECT COUNT(*) FROM dbo.vw_ContractInfo AS c
        WHERE c.TenantKey = t.TenantKey
          AND CAST(GETDATE() AS DATE) BETWEEN c.StartDate AND c.EffectiveEndDate) AS ActiveContracts,
       (SELECT ISNULL(SUM(f.DebtAmount), 0) FROM dbo.Fact_Invoice AS f WHERE f.TenantKey = t.TenantKey) AS DebtNow
FROM dbo.Dim_Tenant AS t
WHERE t.TenantID = @TenantID;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="TenantID">
          <DataField>TenantID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TenantType">
          <DataField>TenantType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TaxCode">
          <DataField>TaxCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Phone">
          <DataField>Phone</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Email">
          <DataField>Email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ContractsCount">
          <DataField>ContractsCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ActiveContracts">
          <DataField>ActiveContracts</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DebtNow">
          <DataField>DebtNow</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Contracts">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TenantID">
            <Value>=Parameters!TenantID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- договори орендаря: приміщення в поточній версії SCD2, суми з факту рахунків
SELECT c.ContractID, c.ContractNumber, p.City, p.Address, p.PremisesType, p.Area,
       c.SignDate, c.StartDate, c.EffectiveEndDate AS RentEndDate,
       CASE WHEN c.IsTerminated = 1 THEN N'Розірвано'
            WHEN c.EndDate &lt; CAST(GETDATE() AS DATE) THEN N'Завершено'
            WHEN c.StartDate &gt; CAST(GETDATE() AS DATE) THEN N'Ще не почався'
            ELSE N'Діє' END AS ContractState,
       c.MonthlyRent, c.Deposit, c.PaymentDay,
       inv.InvoicesCount, inv.Invoiced, inv.Paid, inv.Debt
FROM dbo.vw_ContractInfo AS c
JOIN dbo.Dim_Tenant AS t   ON t.TenantKey = c.TenantKey
JOIN dbo.Dim_Premises AS p ON p.PremisesID = c.PremisesID AND p.IsCurrent = 1
CROSS APPLY (SELECT COUNT(*) AS InvoicesCount, SUM(f.TotalAmount) AS Invoiced,
                    SUM(f.PaidAmount) AS Paid, SUM(f.DebtAmount) AS Debt
             FROM dbo.Fact_Invoice AS f WHERE f.ContractKey = c.ContractKey) AS inv
WHERE t.TenantID = @TenantID
ORDER BY c.StartDate;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="ContractID">
          <DataField>ContractID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ContractNumber">
          <DataField>ContractNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="City">
          <DataField>City</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Address">
          <DataField>Address</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PremisesType">
          <DataField>PremisesType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Area">
          <DataField>Area</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SignDate">
          <DataField>SignDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RentEndDate">
          <DataField>RentEndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ContractState">
          <DataField>ContractState</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MonthlyRent">
          <DataField>MonthlyRent</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Deposit">
          <DataField>Deposit</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="PaymentDay">
          <DataField>PaymentDay</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InvoicesCount">
          <DataField>InvoicesCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>Invoiced</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>Paid</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Debt">
          <DataField>Debt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
