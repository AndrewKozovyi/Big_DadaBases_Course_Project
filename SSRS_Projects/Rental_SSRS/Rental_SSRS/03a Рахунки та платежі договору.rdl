<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Підзвіт: рахунки договору та платежі за ними (використовується у звіті «03 Довідка орендаря»).</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalDW">
      <DataSourceReference>RentalDW</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>8e083128-0f9f-4546-9e28-b5e09c1d94bf</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Invoices">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ContractID">
            <Value>=Parameters!ContractID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- Рахунки договору (Fact_Invoice) та платежі за ними (Fact_Payment);
-- рахунок без платежів дає один рядок з PaymentID = NULL
SELECT f.InvoiceID, f.InvoiceNumber, dp.FullDate AS PeriodMonth, di.FullDate AS IssueDate, dd.FullDate AS DueDate,
       f.RentAmount, f.UtilitiesAmount, f.PenaltyAmount, f.TotalAmount,
       s.StatusID, s.StatusName AS InvoiceStatus,
       p.PaymentID, dpay.FullDate AS PaymentDate, p.Amount, p.PaymentTiming,
       CASE WHEN p.DaysLate &gt; 0 THEN p.DaysLate ELSE 0 END AS DaysLate
FROM dbo.Fact_Invoice AS f
JOIN dbo.Dim_Contract AS c      ON c.ContractKey = f.ContractKey
JOIN dbo.Dim_InvoiceStatus AS s ON s.StatusKey = f.StatusKey
JOIN dbo.Dim_Date AS dp         ON dp.DateKey = f.PeriodDateKey
JOIN dbo.Dim_Date AS di         ON di.DateKey = f.IssueDateKey
JOIN dbo.Dim_Date AS dd         ON dd.DateKey = f.DueDateKey
LEFT JOIN dbo.Fact_Payment AS p ON p.InvoiceID = f.InvoiceID
LEFT JOIN dbo.Dim_Date AS dpay  ON dpay.DateKey = p.PaymentDateKey
WHERE c.ContractID = @ContractID
ORDER BY f.PeriodDateKey, p.PaymentDateKey;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="InvoiceID">
          <DataField>InvoiceID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InvoiceNumber">
          <DataField>InvoiceNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PeriodMonth">
          <DataField>PeriodMonth</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="IssueDate">
          <DataField>IssueDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DueDate">
