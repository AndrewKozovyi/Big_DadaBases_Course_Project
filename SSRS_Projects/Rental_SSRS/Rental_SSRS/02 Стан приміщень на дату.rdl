        </Field>
        <Field Name="TenantName">
          <DataField>TenantName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TaxCode">
          <DataField>TaxCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="RentEndDate">
          <DataField>RentEndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="MonthlyRent">
          <DataField>MonthlyRent</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Cities">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <CommandText>SELECT DISTINCT City FROM dbo.Dim_Premises WHERE IsCurrent = 1 ORDER BY City;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="City">
          <DataField>City</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PremisesTypes">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@City">
            <Value>=Parameters!City.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT PremisesType
FROM dbo.Dim_Premises
WHERE IsCurrent = 1 AND City IN (@City)
ORDER BY PremisesType;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PremisesType">
          <DataField>PremisesType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
