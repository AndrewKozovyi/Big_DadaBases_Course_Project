<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Стан кожного приміщення на вибрану дату: вільне чи орендоване, орендар, договір. Варіант 2, звіт 2. Джерело — сховище RentalDW (функція dbo.fn_PremisesStateOnDate, версії SCD2 на дату).</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalDW">
      <DataSourceReference>RentalDW</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>46b0178d-d724-4bf5-86c8-51871a477379</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Main">
      <Query>
        <DataSourceName>RentalDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Date">
            <Value>=Parameters!Date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@City">
            <Value>=Parameters!City.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PremisesType">
            <Value>=Parameters!PremisesType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@OnlyFree">
            <Value>=Parameters!OnlyFree.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- Стан кожного приміщення на дату (сховище RentalDW): версія приміщення SCD2, чинна на дату,
-- договір, що діє на дату, і орендар
SELECT s.PremisesID, s.City, s.Address, s.PremisesType, s.TypeGroup, s.Floor, s.RoomsCount, s.Area,
       s.MonthlyPrice, s.State, s.ContractNumber, s.TenantID, s.TenantName, s.TaxCode,
       s.StartDate, s.RentEndDate, s.MonthlyRent
FROM dbo.fn_PremisesStateOnDate(@Date) AS s
WHERE s.City IN (@City)
  AND s.PremisesType IN (@PremisesType)
  AND (@OnlyFree = 0 OR s.State = N'Вільне')
ORDER BY s.City, s.Address;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PremisesID">
          <DataField>PremisesID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="City">
          <DataField>City</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Address">
          <DataField>Address</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PremisesType">
          <DataField>PremisesType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TypeGroup">
          <DataField>TypeGroup</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Floor">
