            <ChartData>
              <ChartSeriesCollection>
                <ChartSeries Name="Invoiced">
                  <ChartDataPoints>
                    <ChartDataPoint>
                      <ChartDataPointValues>
                        <Y>=Sum(Fields!Invoiced.Value) / 1000000</Y>
                      </ChartDataPointValues>
                      <ChartDataLabel>
                        <Style>
                          <FontFamily>Segoe UI</FontFamily>
                          <FontSize>7pt</FontSize>
                        </Style>
                        <Label>#VALY{N1}</Label>
                        <Visible>true</Visible>
                      </ChartDataLabel>
                      <ToolTip>=Fields!Year.Value &amp; ": виставлено " &amp; Format(Sum(Fields!Invoiced.Value), "#,##0") &amp; " грн"</ToolTip>
                      <ActionInfo>
                        <Actions>
                          <Action>
                            <Drillthrough>
                              <ReportName>01 Орендарі та борги</ReportName>
                              <Parameters>
                                <Parameter Name="DateFrom">
                                  <Value>=DateSerial(CInt(Fields!YearKey.Value), 1, 1)</Value>
                                </Parameter>
                                <Parameter Name="DateTo">
                                  <Value>=DateSerial(CInt(Fields!YearKey.Value), 12, 31)</Value>
                                </Parameter>
                                <Parameter Name="OnlyDebtors">
                                  <Value>true</Value>
                                </Parameter>
                              </Parameters>
                            </Drillthrough>
                          </Action>
                        </Actions>
                      </ActionInfo>
                      <Style/>
