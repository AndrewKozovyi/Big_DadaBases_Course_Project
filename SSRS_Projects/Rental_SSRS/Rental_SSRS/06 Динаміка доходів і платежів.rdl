<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Діаграми: виставлено/сплачено по роках (Column), платежі та ковзне середнє (Line), структура доходу (Pie), топ-10 боржників (Bar). Джерело — OLAP-куб «Оренда».</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalCube">
      <DataSourceReference>RentalCube</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0f1e432d-4e43-45e0-8e46-5cb1fdde5b71</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="ByYear">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TypeGroups">
            <Value>=Parameters!TypeGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="DateFrom">
            <Value>=Code.DateMember(IIF(Code.BadRange(Parameters!DateFrom.Value, Parameters!DateTo.Value), Parameters!DateTo.Value, Parameters!DateFrom.Value))</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.DateMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[YearKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Сума рахунків], [Measures].[Сплачено], [Measures].[YearKey]} ON COLUMNS,
       NonEmpty([Період].[Календар].[Рік].MEMBERS, [Measures].[Сума рахунків])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TypeGroups, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToMember(@DateFrom, CONSTRAINED) : StrToMember(@DateTo, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Рік]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сплачено]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="YearKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[YearKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ByMonth">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TypeGroups">
            <Value>=Parameters!TypeGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="DateFrom">
            <Value>=Code.DateMember(IIF(Code.BadRange(Parameters!DateFrom.Value, Parameters!DateTo.Value), Parameters!DateTo.Value, Parameters!DateFrom.Value))</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.DateMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[MonthKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Сума платежів], [Measures].[Платежі ковзне середнє 3], [Measures].[MonthKey]} ON COLUMNS,
       NonEmpty([Період].[Календар].[Місяць].MEMBERS, [Measures].[Сума платежів])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TypeGroups, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToMember(@DateFrom, CONSTRAINED) : StrToMember(@DateTo, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Payments">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума платежів]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MovingAvg">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Платежі ковзне середнє 3]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MonthKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[MonthKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ByGroup">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TypeGroups">
            <Value>=Parameters!TypeGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="DateFrom">
            <Value>=Code.DateMember(IIF(Code.BadRange(Parameters!DateFrom.Value, Parameters!DateTo.Value), Parameters!DateTo.Value, Parameters!DateFrom.Value))</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.DateMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT {[Measures].[Дохід від оренди]} ON COLUMNS,
       NON EMPTY [Приміщення].[Група типів].[Група типів].MEMBERS
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TypeGroups, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToMember(@DateFrom, CONSTRAINED) : StrToMember(@DateTo, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="TypeGroup">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Приміщення].[Група типів].[Група типів]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Income">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Дохід від оренди]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Debtors">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TypeGroups">
            <Value>=Parameters!TypeGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="DateFrom">
            <Value>=Code.DateMember(IIF(Code.BadRange(Parameters!DateFrom.Value, Parameters!DateTo.Value), Parameters!DateTo.Value, Parameters!DateFrom.Value))</Value>
          </QueryParameter>
          <QueryParameter Name="DateTo">
            <Value>=Code.DateMember(Parameters!DateTo.Value)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT {[Measures].[Борг]} ON COLUMNS,
       TopCount(NonEmpty([Орендар].[Орендар].[Орендар].MEMBERS, [Measures].[Борг]), 10, [Measures].[Борг])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TypeGroups, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToMember(@DateFrom, CONSTRAINED) : StrToMember(@DateTo, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="Tenant">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Орендар].[Орендар].[Орендар]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Debt">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Борг]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="TypeGroups">
      <SharedDataSet>
        <SharedDataSetReference>TypeGroups</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="ParameterCaption">
          <DataField>ParameterCaption</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ParameterValue">
          <DataField>ParameterValue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
