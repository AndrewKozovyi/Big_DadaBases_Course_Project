<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Дашборд керівника: картки показників, датчики (Gauges) і індикатори KPI куба, спарклайни доходу по містах, матриця за кварталами, діаграма помісячних нарахувань і платежів.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalCube">
      <DataSourceReference>RentalCube</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>efdb215b-c317-4cb8-a506-646377439b03</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="KPI">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH
MEMBER [Measures].[PayValue] AS KPIValue("Рівень оплати рахунків")
MEMBER [Measures].[PayGoal] AS KPIGoal("Рівень оплати рахунків")
MEMBER [Measures].[PayStatus] AS KPIStatus("Рівень оплати рахунків")
MEMBER [Measures].[PayTrend] AS KPITrend("Рівень оплати рахунків")
MEMBER [Measures].[OccValue] AS KPIValue("Завантаженість приміщень")
MEMBER [Measures].[OccGoal] AS KPIGoal("Завантаженість приміщень")
MEMBER [Measures].[OccStatus] AS KPIStatus("Завантаженість приміщень")
MEMBER [Measures].[OccTrend] AS KPITrend("Завантаженість приміщень")
MEMBER [Measures].[OnTValue] AS KPIValue("Своєчасність оплат")
MEMBER [Measures].[OnTGoal] AS KPIGoal("Своєчасність оплат")
MEMBER [Measures].[OnTStatus] AS KPIStatus("Своєчасність оплат")
MEMBER [Measures].[OnTTrend] AS KPITrend("Своєчасність оплат")
MEMBER [Measures].[YearKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[PayValue], [Measures].[PayGoal], [Measures].[PayStatus], [Measures].[PayTrend], [Measures].[OccValue], [Measures].[OccGoal], [Measures].[OccStatus], [Measures].[OccTrend], [Measures].[OnTValue], [Measures].[OnTGoal], [Measures].[OnTStatus], [Measures].[OnTTrend],
        [Measures].[Сума рахунків], [Measures].[Сплачено], [Measures].[Борг], [Measures].[Дохід від оренди],
        [Measures].[Унікальних орендарів], [Measures].[Орендованих приміщень], [Measures].[Кількість договорів],
        [Measures].[Сума рахунків YoY], [Measures].[YearKey]} ON COLUMNS,
       {StrToMember(@Year, CONSTRAINED)} DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM [Оренда]</CommandText>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Рік]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PayValue">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[PayValue]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PayGoal">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[PayGoal]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PayStatus">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[PayStatus]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PayTrend">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[PayTrend]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OccValue">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OccValue]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OccGoal">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OccGoal]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OccStatus">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OccStatus]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OccTrend">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OccTrend]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OnTValue">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OnTValue]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OnTGoal">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OnTGoal]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OnTStatus">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OnTStatus]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="OnTTrend">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[OnTTrend]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сплачено]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Debt">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Борг]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Income">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Дохід від оренди]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Tenants">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Унікальних орендарів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PremisesRented">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Орендованих приміщень]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NewContracts">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість договорів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="InvoicedYoY">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків YoY]" /&gt;</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="YearKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[YearKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Cities">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[MonthKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Дохід від оренди], [Measures].[Орендовані дні], [Measures].[Доступні дні],
        [Measures].[MonthKey]} ON COLUMNS,
       NonEmpty([Приміщення].[Місто].[Місто].MEMBERS * [Період].[Календар].[Місяць].MEMBERS,
                [Measures].[Доступні дні])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToMember(@Year, CONSTRAINED) ON COLUMNS FROM [Оренда])</CommandText>
      </Query>
      <Fields>
        <Field Name="City">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Приміщення].[Місто].[Місто]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Income">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Дохід від оренди]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="RentedDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Орендовані дні]" /&gt;</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="AvailableDays">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Доступні дні]" /&gt;</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="MonthKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[MonthKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="GroupQuarter">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[QuarterKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Сума рахунків], [Measures].[Сплачено], [Measures].[QuarterKey]} ON COLUMNS,
       NonEmpty([Приміщення].[Група типів].[Група типів].MEMBERS * [Період].[Календар].[Квартал].MEMBERS,
                [Measures].[Сума рахунків])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToMember(@Year, CONSTRAINED) ON COLUMNS FROM [Оренда])</CommandText>
      </Query>
      <Fields>
        <Field Name="TypeGroup">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Приміщення].[Група типів].[Група типів]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quarter">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Квартал]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сплачено]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="QuarterKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[QuarterKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Months">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="Year">
            <Value>=Parameters!Year.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[MonthKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Сума рахунків], [Measures].[Сума платежів], [Measures].[MonthKey]} ON COLUMNS,
       NonEmpty([Період].[Календар].[Місяць].MEMBERS, [Measures].[Сума рахунків])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToMember(@Year, CONSTRAINED) ON COLUMNS FROM [Оренда])</CommandText>
      </Query>
      <Fields>
        <Field Name="Month">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Місяць]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Payments">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума платежів]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="MonthKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[MonthKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Years">
      <SharedDataSet>
        <SharedDataSetReference>Years</SharedDataSetReference>
      </SharedDataSet>
      <Fields>
        <Field Name="ParameterCaption">
          <DataField>ParameterCaption</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ParameterValue">
          <DataField>ParameterValue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Textbox">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Панель керівника — " &amp; First(Fields!Year.Value, "KPI") &amp; " рік"</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>15pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1F4E79</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox</rd:DefaultName>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Top</VerticalAlign>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingRight>0pt</PaddingRight>
              <PaddingTop>1pt</PaddingTop>
              <PaddingBottom>1pt</PaddingBottom>
            </Style>
            <Top>0cm</Top>
            <Left>0cm</Left>
            <Height>0.85cm</Height>
            <Width>27.0cm</Width>
          </Textbox>
          <Textbox Name="Textbox1">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Ключові показники оренди, KPI куба «Оренда», динаміка по містах і групах типів. Дані на " &amp; Format(Globals!ExecutionTime, "dd.MM.yyyy HH:mm")</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>8pt</FontSize>
                      <FontStyle>Italic</FontStyle>
                      <Color>#595959</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox1</rd:DefaultName>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>0pt</PaddingLeft>
              <PaddingRight>0pt</PaddingRight>
              <PaddingTop>1pt</PaddingTop>
              <PaddingBottom>1pt</PaddingBottom>
            </Style>
            <Top>0.85cm</Top>
            <Left>0cm</Left>
            <Height>0.45cm</Height>
            <Width>27.0cm</Width>
          </Textbox>
          <Textbox Name="Textbox2">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Виставлено рахунків, грн</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>7pt</FontSize>
                      <Color>White</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox2</rd:DefaultName>
            <Style>
              <Border>
                <Color>#1F4E79</Color>
                <Style>Solid</Style>
