                              <ScaleFactor>1</ScaleFactor>
                              <IndicatorStates>
                                <IndicatorState Name="CityState_S">
                                  <StartValue>
                                    <Value>-1000000</Value>
                                    <Multiplier>1</Multiplier>
                                  </StartValue>
                                  <EndValue>
                                    <Value>1000000</Value>
                                    <Multiplier>1</Multiplier>
                                  </EndValue>
                                  <Color>=Switch(IIF(Code.Ratio(Sum(Fields!RentedDays.Value), Sum(Fields!AvailableDays.Value)) &gt;= 0.8, 1, IIF(Code.Ratio(Sum(Fields!RentedDays.Value), Sum(Fields!AvailableDays.Value)) &gt;= 0.6, 0, -1)) &gt;= 1, "Green", IIF(Code.Ratio(Sum(Fields!RentedDays.Value), Sum(Fields!AvailableDays.Value)) &gt;= 0.8, 1, IIF(Code.Ratio(Sum(Fields!RentedDays.Value), Sum(Fields!AvailableDays.Value)) &gt;= 0.6, 0, -1)) = 0, "Gold", True, "Red")</Color>
