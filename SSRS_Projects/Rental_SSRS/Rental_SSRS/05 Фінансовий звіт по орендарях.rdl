    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Textbox34">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Фінансовий звіт по орендарях</Value>
                    <Style>
                      <FontFamily>Segoe UI</FontFamily>
                      <FontSize>15pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1F4E79</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style/>
              </Paragraph>
