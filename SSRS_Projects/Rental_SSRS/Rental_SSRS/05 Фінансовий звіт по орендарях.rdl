<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily" MustUnderstand="df">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Нараховано, сплачено, борг і рівень оплати по орендарях за роками; групування за типом орендаря з розгортанням. Варіант 2, звіт 5. Джерело — OLAP-куб «Оренда».</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RentalCube">
      <DataSourceReference>RentalCube</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9a27400c-d896-402c-a8dd-7f99b73f37c2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Top">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TenantTypes">
            <Value>=Parameters!TenantTypes.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Years">
            <Value>=Parameters!Years.Value</Value>
          </QueryParameter>
          <QueryParameter Name="TopN">
            <Value>=CStr(Parameters!TopN.Value)</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH
MEMBER [Measures].[TaxCode] AS [Орендар].[Орендар].CURRENTMEMBER.PROPERTIES("Податковий код")
MEMBER [Measures].[YearKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Сума рахунків], [Measures].[Сплачено], [Measures].[Борг], [Measures].[Кількість рахунків],
        [Measures].[TaxCode], [Measures].[YearKey]} ON COLUMNS,
       NonEmpty(
         Generate([Орендар].[Тип орендаря].[Тип орендаря].MEMBERS,
                  {[Орендар].[Тип орендаря].CURRENTMEMBER}
                  * TopCount(NonEmpty(Exists([Орендар].[Орендар].[Орендар].MEMBERS,
                                             {[Орендар].[Тип орендаря].CURRENTMEMBER}),
                                      [Measures].[Сума рахунків]),
                             StrToValue(@TopN), [Measures].[Сума рахунків]))
         * [Період].[Календар].[Рік].MEMBERS,
         [Measures].[Кількість рахунків])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TenantTypes, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToSet(@Years, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="TenantType">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Орендар].[Тип орендаря].[Тип орендаря]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Tenant">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Орендар].[Орендар].[Орендар]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Рік]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сплачено]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Debt">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Борг]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Invoices">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Кількість рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TaxCode">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[TaxCode]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="YearKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[YearKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Totals">
      <Query>
        <DataSourceName>RentalCube</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="TenantTypes">
            <Value>=Parameters!TenantTypes.Value</Value>
          </QueryParameter>
          <QueryParameter Name="Years">
            <Value>=Parameters!Years.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH MEMBER [Measures].[YearKey] AS [Період].[Календар].CURRENTMEMBER.MEMBER_KEY
SELECT {[Measures].[Сума рахунків], [Measures].[Сплачено], [Measures].[Борг], [Measures].[Унікальних орендарів],
        [Measures].[YearKey]} ON COLUMNS,
       NonEmpty([Орендар].[Тип орендаря].[Тип орендаря].MEMBERS * [Період].[Календар].[Рік].MEMBERS,
                [Measures].[Кількість рахунків])
       DIMENSION PROPERTIES MEMBER_CAPTION ON ROWS
FROM (SELECT StrToSet(@TenantTypes, CONSTRAINED) ON COLUMNS
      FROM (SELECT StrToSet(@Years, CONSTRAINED) ON COLUMNS FROM [Оренда]))</CommandText>
      </Query>
      <Fields>
        <Field Name="TenantType">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Орендар].[Тип орендаря].[Тип орендаря]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Year">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Level" UniqueName="[Період].[Календар].[Рік]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Invoiced">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сума рахунків]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Paid">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Сплачено]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Debt">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Борг]" /&gt;</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Tenants">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[Унікальних орендарів]" /&gt;</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="YearKey">
          <DataField>&lt;?xml version="1.0" encoding="utf-8"?&gt;&lt;Field xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Measure" UniqueName="[Measures].[YearKey]" /&gt;</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
