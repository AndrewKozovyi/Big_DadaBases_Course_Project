          <Source xsi:type="QueryBinding" dwd:design-time-name="2c1dff84-1d36-4070-a2bb-225b3025731a">
            <DataSourceID>RentalDW</DataSourceID>
            <QueryDefinition>SELECT f.*,
       CASE WHEN f.DaysOverdue &gt; 0 THEN 1 ELSE 0 END AS OverdueFlag
