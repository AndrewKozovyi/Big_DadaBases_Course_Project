                  </xs:element>
                  <xs:element name="DurationOrder" msdata:ReadOnly="true" msprop:DbColumnName="DurationOrder" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE [DurationCategory] WHEN N'До місяця' THEN 1 WHEN N'1–3 місяці' THEN 2 WHEN N'4–6 місяців' THEN 3 ELSE 4 END" msprop:design-time-name="f94f63d5-3628-4ddb-b641-102103482e6b" msprop:Description="Порядок категорій тривалості" msprop:FriendlyName="DurationOrder" type="xs:int" minOccurs="0" />
                  <xs:element name="SignYear" msdata:ReadOnly="true" msprop:DbColumnName="SignYear" msprop:IsLogical="True" msprop:ComputedColumnExpression="YEAR([SignDate])" msprop:design-time-name="c121823c-4314-463e-aec6-610444cebd45" msprop:Description="Рік підписання" msprop:FriendlyName="SignYear" type="xs:int" minOccurs="0" />
                  <xs:element name="PeriodLabel" msdata:ReadOnly="true" msprop:DbColumnName="PeriodLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="CONVERT(NVARCHAR(10), [StartDate], 104) + N' – ' + CONVERT(NVARCHAR(10), [EffectiveEndDate], 104)" msprop:design-time-name="e6aad5da-e922-4ddb-ba01-dfd38e5c2f43" msprop:Description="Фактичний період дії договору" msprop:FriendlyName="PeriodLabel" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
