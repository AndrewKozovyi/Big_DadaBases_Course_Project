                  <xs:element name="PremisesLabel" msdata:ReadOnly="true" msprop:DbColumnName="PremisesLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="[City] + N', ' + [Address]" msprop:design-time-name="be4e03a7-8e2d-4626-9dac-5def331a6b40" msprop:Description="Місто й адреса приміщення" msprop:FriendlyName="PremisesLabel" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="260" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="VersionLabel" msdata:ReadOnly="true" msprop:DbColumnName="VersionLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="[City] + N', ' + [Address] + CASE WHEN [IsCurrent] = 1 THEN N'' ELSE N' (до ' + CONVERT(NVARCHAR(10), [ValidTo], 104) + N')' END" msprop:design-time-name="457511d7-aefc-4f51-8f1c-6112cfb08b8d" msprop:Description="Назва версії приміщення (SCD2): для історичних версій — дата закінчення дії" msprop:FriendlyName="VersionLabel" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="300" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="CurrentLabel" msdata:ReadOnly="true" msprop:DbColumnName="CurrentLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [IsCurrent] = 1 THEN N'Поточна версія' ELSE N'Історична версія' END" msprop:design-time-name="d9e2e925-f38e-42ac-a29d-1c283a7a33b6" msprop:Description="Тип версії SCD2" msprop:FriendlyName="CurrentLabel" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="FloorOrder" msdata:ReadOnly="true" msprop:DbColumnName="FloorOrder" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE [FloorCategory] WHEN N'Підземний' THEN 1 WHEN N'Цокольний' THEN 2 WHEN N'Перший' THEN 3 WHEN N'2–5 поверх' THEN 4 WHEN N'6–10 поверх' THEN 5 WHEN N'11+ поверх' THEN 6 ELSE 7 END" msprop:design-time-name="4222f41f-7e71-4986-837c-3c022c325411" msprop:Description="Порядок категорій поверху" msprop:FriendlyName="FloorOrder" type="xs:int" minOccurs="0" />
                  <xs:element name="AreaOrder" msdata:ReadOnly="true" msprop:DbColumnName="AreaOrder" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE [AreaCategory] WHEN N'до 30 м²' THEN 1 WHEN N'30–100 м²' THEN 2 WHEN N'100–500 м²' THEN 3 ELSE 4 END" msprop:design-time-name="f2622429-30d2-4d78-9e70-47915009e96c" msprop:Description="Порядок категорій площі" msprop:FriendlyName="AreaOrder" type="xs:int" minOccurs="0" />
                  <xs:element name="PriceOrder" msdata:ReadOnly="true" msprop:DbColumnName="PriceOrder" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [MonthlyPrice] &lt; 5000 THEN 1 WHEN [MonthlyPrice] &lt; 15000 THEN 2 WHEN [MonthlyPrice] &lt; 50000 THEN 3 ELSE 4 END" msprop:design-time-name="c7ae452d-41e2-47f6-93c2-7df8abfb988d" msprop:Description="Порядок цінових категорій" msprop:FriendlyName="PriceOrder" type="xs:int" minOccurs="0" />
                  <xs:element name="PriceCategory" msdata:ReadOnly="true" msprop:DbColumnName="PriceCategory" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [MonthlyPrice] &lt; 5000 THEN N'до 5 тис. грн' WHEN [MonthlyPrice] &lt; 15000 THEN N'5–15 тис. грн' WHEN [MonthlyPrice] &lt; 50000 THEN N'15–50 тис. грн' ELSE N'понад 50 тис. грн' END" msprop:design-time-name="42f6cd34-437b-4f31-8f3f-aa603ac7e22e" msprop:Description="Цінова категорія за місячною ставкою" msprop:FriendlyName="PriceCategory" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="FloorText" msdata:ReadOnly="true" msprop:DbColumnName="FloorText" msprop:IsLogical="True" msprop:ComputedColumnExpression="ISNULL(CAST([Floor] AS NVARCHAR(10)), N'—')" msprop:design-time-name="093cd444-d419-44b7-b6c0-1a91038737fe" msprop:Description="Поверх (— для окремого будинку)" msprop:FriendlyName="FloorText" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="10" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
