                  <xs:element name="PaidAmount" msprop:FriendlyName="PaidAmount" msprop:DbColumnName="PaidAmount" msprop:design-time-name="b4f1b1c9-bc63-40e5-b0a9-1986509d5611" type="xs:decimal" />
                  <xs:element name="DebtAmount" msprop:FriendlyName="DebtAmount" msprop:DbColumnName="DebtAmount" msprop:design-time-name="216f4750-59bb-446c-9856-5094b060a9ad" type="xs:decimal" />
                  <xs:element name="DaysOverdue" msprop:FriendlyName="DaysOverdue" msprop:DbColumnName="DaysOverdue" msprop:design-time-name="e8624612-2ae5-4195-9434-8d85703c01f2" type="xs:int" />
