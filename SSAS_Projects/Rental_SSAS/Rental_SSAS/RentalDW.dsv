  <Schema>
    <xs:schema id="RentalDW" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
      <xs:element name="RentalDW" msdata:IsDataSet="true" msdata:UseCurrentLocale="true" msprop:design-time-name="1a31da82-7e7c-4eb2-80c2-d36dfac01aca">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="dbo_Dim_Date" msprop:DbSchemaName="dbo" msprop:design-time-name="1a8ae2bd-ae7e-4175-a35b-084dc49e41e8" msprop:Description="Вимір дати (календар зі святами України)" msprop:FriendlyName="Dim_Date" msprop:TableType="Table" msprop:DbTableName="Dim_Date">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="DateKey" msprop:FriendlyName="DateKey" msprop:DbColumnName="DateKey" msprop:design-time-name="6fdf4a36-88b0-41fc-9025-cb2ca0f25bcb" type="xs:int" />
                  <xs:element name="FullDate" msprop:FriendlyName="FullDate" msprop:DbColumnName="FullDate" msprop:design-time-name="290be8e2-2c18-4a96-a713-0331e92b8038" type="xs:dateTime" />
                  <xs:element name="Year" msprop:FriendlyName="Year" msprop:DbColumnName="Year" msprop:design-time-name="f9bb600b-9167-4413-a392-a6d433d40c8e" type="xs:short" />
                  <xs:element name="Quarter" msprop:FriendlyName="Quarter" msprop:DbColumnName="Quarter" msprop:design-time-name="9e4f678e-24be-4970-a344-f04032543802" type="xs:unsignedByte" />
                  <xs:element name="QuarterName" msprop:FriendlyName="QuarterName" msprop:DbColumnName="QuarterName" msprop:design-time-name="b4ee451d-580d-4878-afc9-978fb452d7cf">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="10" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="Month" msprop:FriendlyName="Month" msprop:DbColumnName="Month" msprop:design-time-name="0abb7528-b8d2-452c-b833-c90ba3b74f10" type="xs:unsignedByte" />
                  <xs:element name="MonthName" msprop:FriendlyName="MonthName" msprop:DbColumnName="MonthName" msprop:design-time-name="545c99f5-782d-4e15-9774-19d767f9c88e">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="YearMonth" msprop:FriendlyName="YearMonth" msprop:DbColumnName="YearMonth" msprop:design-time-name="86c8264f-0a0a-482a-a4e8-23c3dfc107ea" type="xs:int" />
                  <xs:element name="Day" msprop:FriendlyName="Day" msprop:DbColumnName="Day" msprop:design-time-name="9f9380f2-92f3-435f-95cc-ea2ade2bdcc2" type="xs:unsignedByte" />
                  <xs:element name="DayOfWeek" msprop:FriendlyName="DayOfWeek" msprop:DbColumnName="DayOfWeek" msprop:design-time-name="75b13310-7ace-492b-a3e4-c3d1e73a9765" type="xs:unsignedByte" />
                  <xs:element name="DayName" msprop:FriendlyName="DayName" msprop:DbColumnName="DayName" msprop:design-time-name="55b12b08-38b8-4846-9a7f-10e4f9441f7d">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="15" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="WeekOfYear" msprop:FriendlyName="WeekOfYear" msprop:DbColumnName="WeekOfYear" msprop:design-time-name="64e33091-9317-43b8-a5dd-fc1bc18a042e" type="xs:unsignedByte" />
                  <xs:element name="IsWeekend" msprop:FriendlyName="IsWeekend" msprop:DbColumnName="IsWeekend" msprop:design-time-name="911ed43f-3fcf-4000-a557-e06a0d54d317" type="xs:boolean" />
                  <xs:element name="IsHoliday" msprop:FriendlyName="IsHoliday" msprop:DbColumnName="IsHoliday" msprop:design-time-name="13de632b-ce8c-4fdb-b55c-88659e56a21a" type="xs:boolean" />
                  <xs:element name="HolidayName" msprop:FriendlyName="HolidayName" msprop:DbColumnName="HolidayName" msprop:design-time-name="4860a8af-f223-4482-b0e0-55f05435e3de" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="100" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="IsWorkingDay" msprop:FriendlyName="IsWorkingDay" msprop:DbColumnName="IsWorkingDay" msprop:design-time-name="6fefc961-59ca-4407-bb0a-323d071e5df2" type="xs:boolean" />
                  <xs:element name="DateLabel" msdata:ReadOnly="true" msprop:DbColumnName="DateLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="CONVERT(NVARCHAR(10), [FullDate], 104)" msprop:design-time-name="891d66b8-3195-46c5-8b81-c3ff7d021930" msprop:Description="Дата у форматі дд.мм.рррр" msprop:FriendlyName="DateLabel" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="10" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="QuarterKey" msdata:ReadOnly="true" msprop:DbColumnName="QuarterKey" msprop:IsLogical="True" msprop:ComputedColumnExpression="[Year] * 10 + [Quarter]" msprop:design-time-name="948f9b32-2b08-48b9-a91d-07060cfe88ac" msprop:Description="Унікальний ключ кварталу (рік + номер)" msprop:FriendlyName="QuarterKey" type="xs:int" minOccurs="0" />
                  <xs:element name="QuarterLabel" msdata:ReadOnly="true" msprop:DbColumnName="QuarterLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="CAST([Quarter] AS NVARCHAR(1)) + N' кв. ' + CAST([Year] AS NVARCHAR(4))" msprop:design-time-name="f942bc17-9915-4c90-b1ea-e9ef4c55fb13" msprop:Description="Назва кварталу з роком" msprop:FriendlyName="QuarterLabel" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="MonthLabel" msdata:ReadOnly="true" msprop:DbColumnName="MonthLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="[MonthName] + N' ' + CAST([Year] AS NVARCHAR(4))" msprop:design-time-name="0b4ee5c7-65ae-48f4-b237-77a1d4f8312e" msprop:Description="Назва місяця з роком" msprop:FriendlyName="MonthLabel" minOccurs="0">
