                  <xs:element name="VersionLabel" msprop:FriendlyName="VersionLabel" msprop:DbColumnName="VersionLabel" msprop:design-time-name="457511d7-aefc-4f51-8f1c-6112cfb08b8d" msdata:ReadOnly="true" msprop:ComputedColumnExpression="[City] + N', ' + [Address] + CASE WHEN [IsCurrent] = 1 THEN N'' ELSE N' (до ' + CONVERT(NVARCHAR(10), [ValidTo], 104) + N')' END" msprop:Description="Назва версії приміщення (SCD2): для історичних версій — дата закінчення дії" msprop:IsLogical="True" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="300" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="CurrentLabel" msprop:FriendlyName="CurrentLabel" msprop:DbColumnName="CurrentLabel" msprop:design-time-name="d9e2e925-f38e-42ac-a29d-1c283a7a33b6" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [IsCurrent] = 1 THEN N'Поточна версія' ELSE N'Історична версія' END" msprop:Description="Тип версії SCD2" msprop:IsLogical="True" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="FloorOrder" msprop:FriendlyName="FloorOrder" msprop:DbColumnName="FloorOrder" msprop:design-time-name="4222f41f-7e71-4986-837c-3c022c325411" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE [FloorCategory] WHEN N'Підземний' THEN 1 WHEN N'Цокольний' THEN 2 WHEN N'Перший' THEN 3 WHEN N'2–5 поверх' THEN 4 WHEN N'6–10 поверх' THEN 5 WHEN N'11+ поверх' THEN 6 ELSE 7 END" msprop:Description="Порядок категорій поверху" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                  <xs:element name="AreaOrder" msprop:FriendlyName="AreaOrder" msprop:DbColumnName="AreaOrder" msprop:design-time-name="f2622429-30d2-4d78-9e70-47915009e96c" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE [AreaCategory] WHEN N'до 30 м²' THEN 1 WHEN N'30–100 м²' THEN 2 WHEN N'100–500 м²' THEN 3 ELSE 4 END" msprop:Description="Порядок категорій площі" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                  <xs:element name="PriceOrder" msprop:FriendlyName="PriceOrder" msprop:DbColumnName="PriceOrder" msprop:design-time-name="c7ae452d-41e2-47f6-93c2-7df8abfb988d" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [MonthlyPrice] &lt; 5000 THEN 1 WHEN [MonthlyPrice] &lt; 15000 THEN 2 WHEN [MonthlyPrice] &lt; 50000 THEN 3 ELSE 4 END" msprop:Description="Порядок цінових категорій" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                  <xs:element name="PriceCategory" msprop:FriendlyName="PriceCategory" msprop:DbColumnName="PriceCategory" msprop:design-time-name="42f6cd34-437b-4f31-8f3f-aa603ac7e22e" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [MonthlyPrice] &lt; 5000 THEN N'до 5 тис. грн' WHEN [MonthlyPrice] &lt; 15000 THEN N'5–15 тис. грн' WHEN [MonthlyPrice] &lt; 50000 THEN N'15–50 тис. грн' ELSE N'понад 50 тис. грн' END" msprop:Description="Цінова категорія за місячною ставкою" msprop:IsLogical="True" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="FloorText" msprop:FriendlyName="FloorText" msprop:DbColumnName="FloorText" msprop:design-time-name="093cd444-d419-44b7-b6c0-1a91038737fe" msdata:ReadOnly="true" msprop:ComputedColumnExpression="ISNULL(CAST([Floor] AS NVARCHAR(10)), N'—')" msprop:Description="Поверх (— для окремого будинку)" msprop:IsLogical="True" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="10" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="dbo_Dim_Contract" msprop:design-time-name="ac874d0a-70d9-4539-9bb4-cba9c1de0710" msprop:FriendlyName="Dim_Contract" msprop:TableType="Table" msprop:DbSchemaName="dbo" msprop:DbTableName="Dim_Contract" msprop:Description="Договори оренди (SCD1)">
              <xs:complexType>
                <xs:sequence>
