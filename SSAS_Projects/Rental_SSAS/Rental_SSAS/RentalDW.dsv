                  <xs:element name="EffectiveEndDate" msprop:FriendlyName="EffectiveEndDate" msprop:DbColumnName="EffectiveEndDate" msprop:design-time-name="084b0600-a10a-4239-bc23-778cc12844b4" type="xs:dateTime" />
                  <xs:element name="DurationMonths" msprop:FriendlyName="DurationMonths" msprop:DbColumnName="DurationMonths" msprop:design-time-name="b8065d7f-9bd6-43ba-83d8-c9eebd206f50" type="xs:int" />
                  <xs:element name="DurationCategory" msprop:FriendlyName="DurationCategory" msprop:DbColumnName="DurationCategory" msprop:design-time-name="ec8b52bd-39e1-492a-94e5-8699bf013167">
