                  </xs:element>
                  <xs:element name="HolidayLabel" msdata:ReadOnly="true" msprop:DbColumnName="HolidayLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="ISNULL([HolidayName], N'(не свято)')" msprop:design-time-name="b7228d4c-83b6-4780-b0f4-7fa153840576" msprop:Description="Назва свята або «(не свято)»" msprop:FriendlyName="HolidayLabel" minOccurs="0">
                    <xs:simpleType>
