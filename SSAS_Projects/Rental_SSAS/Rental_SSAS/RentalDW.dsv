            <xs:element name="dbo_Fact_Payment" msprop:design-time-name="e59627d8-cf1e-4772-8d1b-92c8bff963a9" msprop:FriendlyName="Fact_Payment" msprop:TableType="Table" msprop:DbSchemaName="dbo" msprop:DbTableName="Fact_Payment" msprop:Description="Факти: платежі">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="PaymentID" msprop:FriendlyName="PaymentID" msprop:DbColumnName="PaymentID" msprop:design-time-name="9d47ade7-d522-445d-8065-ef6330bf4797" type="xs:int" />
                  <xs:element name="InvoiceID" msprop:FriendlyName="InvoiceID" msprop:DbColumnName="InvoiceID" msprop:design-time-name="191183a0-81b3-4d96-ada9-8edc79bfb94f" type="xs:int" />
                  <xs:element name="PaymentDateKey" msprop:FriendlyName="PaymentDateKey" msprop:DbColumnName="PaymentDateKey" msprop:design-time-name="3bb49710-c70a-47f0-a0bf-ae1903fdb616" type="xs:int" />
                  <xs:element name="DueDateKey" msprop:FriendlyName="DueDateKey" msprop:DbColumnName="DueDateKey" msprop:design-time-name="a1bc6ac2-9b58-4c46-bc78-09777f39d0eb" type="xs:int" />
                  <xs:element name="ContractKey" msprop:FriendlyName="ContractKey" msprop:DbColumnName="ContractKey" msprop:design-time-name="d894fd6e-e9fc-4c80-bef1-fe28b5ed034d" type="xs:int" />
