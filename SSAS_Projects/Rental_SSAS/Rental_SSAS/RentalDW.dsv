            <xs:element name="Contract_Facts" msprop:QueryBuilder="SpecificQueryBuilder" msprop:IsLogical="True" msprop:design-time-name="aa46222c-6d5e-49ff-9490-a0d8295809b3" msprop:QueryDefinition="SELECT c.ContractKey,&#xD;&#xA;       YEAR(c.StartDate) * 10000 + MONTH(c.StartDate) * 100 + DAY(c.StartDate) AS StartDateKey,&#xD;&#xA;       f.TenantKey,&#xD;&#xA;       f.PremisesKey,&#xD;&#xA;       c.MonthlyRent,&#xD;&#xA;       c.Deposit,&#xD;&#xA;       c.DurationMonths&#xD;&#xA;FROM dbo.Dim_Contract AS c&#xD;&#xA;LEFT JOIN (SELECT ContractKey, TenantKey, PremisesKey,&#xD;&#xA;                  ROW_NUMBER() OVER (PARTITION BY ContractKey ORDER BY PeriodDateKey DESC) AS rn&#xD;&#xA;           FROM dbo.Fact_Invoice) AS f&#xD;&#xA;       ON f.ContractKey = c.ContractKey AND f.rn = 1" msprop:FriendlyName="Contract_Facts" msprop:TableType="View" msprop:DbTableName="Contract_Facts" msprop:Description="Договори як факти: дата початку, орендар і приміщення (з останнього рахунку), ставка, депозит, тривалість">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="ContractKey" msprop:FriendlyName="ContractKey" msprop:DbColumnName="ContractKey" msprop:design-time-name="628798f3-d04c-49a5-8a2e-163de6890ba3" type="xs:int" />
                  <xs:element name="StartDateKey" msprop:FriendlyName="StartDateKey" msprop:DbColumnName="StartDateKey" msprop:design-time-name="0567095b-ddfe-4b98-bd56-db3d5dc247c7" type="xs:int" />
                  <xs:element name="TenantKey" msprop:FriendlyName="TenantKey" msprop:DbColumnName="TenantKey" msprop:design-time-name="380bef7e-c37d-478a-ba62-e12f71dfcbe7" type="xs:int" minOccurs="0" />
                  <xs:element name="PremisesKey" msprop:FriendlyName="PremisesKey" msprop:DbColumnName="PremisesKey" msprop:design-time-name="43b10b70-80d8-4107-b1a8-6bd29a5c6b21" type="xs:int" minOccurs="0" />
                  <xs:element name="MonthlyRent" msprop:FriendlyName="MonthlyRent" msprop:DbColumnName="MonthlyRent" msprop:design-time-name="32e2b49f-3c81-4e7f-bd95-ed4ccf358ac5" type="xs:decimal" />
                  <xs:element name="Deposit" msprop:FriendlyName="Deposit" msprop:DbColumnName="Deposit" msprop:design-time-name="cd335175-aea6-47ae-88d1-d1fb236fb8c0" type="xs:decimal" />
                  <xs:element name="DurationMonths" msprop:FriendlyName="DurationMonths" msprop:DbColumnName="DurationMonths" msprop:design-time-name="5c1018be-23b9-4ed2-bdfd-a0c1e3f10c03" type="xs:int" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="Payment_Timing" msprop:QueryBuilder="SpecificQueryBuilder" msprop:IsLogical="True" msprop:design-time-name="da019db8-5835-4619-81d8-798ec35593d9" msprop:QueryDefinition="SELECT v.PaymentTiming, v.TimingOrder&#xD;&#xA;FROM (VALUES (N'Наперед', 1), (N'Вчасно', 2), (N'Із запізненням', 3)) AS v (PaymentTiming, TimingOrder)" msprop:FriendlyName="Payment_Timing" msprop:TableType="View" msprop:DbTableName="Payment_Timing" msprop:Description="Довідник своєчасності оплати (значення, які формує ETL у Fact_Payment.PaymentTiming)">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="PaymentTiming" msprop:FriendlyName="PaymentTiming" msprop:DbColumnName="PaymentTiming" msprop:design-time-name="59f3e143-7612-489b-8beb-7e5f4899e8c8">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="TimingOrder" msprop:FriendlyName="TimingOrder" msprop:DbColumnName="TimingOrder" msprop:design-time-name="3d353f0f-8c23-4afa-ad68-826da36becb3" type="xs:int" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:choice>
        </xs:complexType>
