                  <xs:element name="WeekLabel" msdata:ReadOnly="true" msprop:DbColumnName="WeekLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="N'Тиждень ' + RIGHT(N'0' + CAST([WeekOfYear] AS NVARCHAR(2)), 2) + N', ' + CAST([Year] AS NVARCHAR(4))" msprop:design-time-name="8b729959-02e4-4566-ac1a-cd191a867504" msprop:Description="Назва тижня з роком" msprop:FriendlyName="WeekLabel" minOccurs="0">
