                  <xs:element name="PremisesKey" msprop:FriendlyName="PremisesKey" msprop:DbColumnName="PremisesKey" msprop:design-time-name="68b101b7-ab26-4d0d-b2c6-49b7c3089a73" type="xs:int" />
                  <xs:element name="Amount" msprop:FriendlyName="Amount" msprop:DbColumnName="Amount" msprop:design-time-name="d3271e92-0a3b-48ce-b685-a84c505116c8" type="xs:decimal" />
                  <xs:element name="DaysLate" msprop:FriendlyName="DaysLate" msprop:DbColumnName="DaysLate" msprop:design-time-name="f78c8d31-7962-4db1-bd4f-95d7ab97e7d5" type="xs:int" />
                  <xs:element name="PaymentTiming" msprop:FriendlyName="PaymentTiming" msprop:DbColumnName="PaymentTiming" msprop:design-time-name="d318f2c4-74b6-43fb-81e7-8953898bc092">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="20" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="RunID" msprop:FriendlyName="RunID" msprop:DbColumnName="RunID" msprop:design-time-name="8941613a-e117-4b25-ab7a-a368936942d9" type="xs:int" />
                  <xs:element name="LateFlag" msprop:FriendlyName="LateFlag" msprop:DbColumnName="LateFlag" msprop:design-time-name="6db37e9a-d327-437f-8a3e-f4959606accd" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [DaysLate] &gt; 0 THEN 1 ELSE 0 END" msprop:Description="1 — оплачено із запізненням" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                  <xs:element name="LateDays" msprop:FriendlyName="LateDays" msprop:DbColumnName="LateDays" msprop:design-time-name="c4d71f76-7d0c-4324-8c39-f76c0dbf7cde" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [DaysLate] &gt; 0 THEN [DaysLate] ELSE 0 END" msprop:Description="Дні запізнення (0 — вчасно)" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="dbo_Fact_Occupancy" msprop:design-time-name="df5131c5-5d1b-43cd-91ad-9c61e5a8f36c" msprop:FriendlyName="Fact_Occupancy" msprop:TableType="Table" msprop:DbSchemaName="dbo" msprop:DbTableName="Fact_Occupancy" msprop:Description="Факти: завантаженість приміщень по місяцях">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="PremisesKey" msprop:FriendlyName="PremisesKey" msprop:DbColumnName="PremisesKey" msprop:design-time-name="4231a338-e386-4567-9d73-f11b56dafbf7" type="xs:int" />
                  <xs:element name="MonthDateKey" msprop:FriendlyName="MonthDateKey" msprop:DbColumnName="MonthDateKey" msprop:design-time-name="3137e1ad-3193-4430-8052-91c31def0e63" type="xs:int" />
                  <xs:element name="RentedDays" msprop:FriendlyName="RentedDays" msprop:DbColumnName="RentedDays" msprop:design-time-name="66aff8a5-9f3e-425b-bc6a-bd71eca46f53" type="xs:int" />
                  <xs:element name="DaysInMonth" msprop:FriendlyName="DaysInMonth" msprop:DbColumnName="DaysInMonth" msprop:design-time-name="1aed3044-fd2e-4d68-86af-74f2fce22b89" type="xs:int" />
                  <xs:element name="OccupancyRate" msprop:FriendlyName="OccupancyRate" msprop:DbColumnName="OccupancyRate" msprop:design-time-name="14194051-fa87-4eda-9249-bc2c08338432" type="xs:decimal" />
                  <xs:element name="ContractsCount" msprop:FriendlyName="ContractsCount" msprop:DbColumnName="ContractsCount" msprop:design-time-name="cae12b38-f2be-4ebb-ac84-dd6a39a22c72" type="xs:int" />
                  <xs:element name="RentIncome" msprop:FriendlyName="RentIncome" msprop:DbColumnName="RentIncome" msprop:design-time-name="21f9adc1-cfdd-440a-9e66-f463b93ae709" type="xs:decimal" />
                  <xs:element name="RunID" msprop:FriendlyName="RunID" msprop:DbColumnName="RunID" msprop:design-time-name="085775a6-be87-479b-8d2d-45c640adc157" type="xs:int" />
                  <xs:element name="OccupiedFlag" msprop:FriendlyName="OccupiedFlag" msprop:DbColumnName="OccupiedFlag" msprop:design-time-name="a95211ac-95bc-41b6-a6c5-39efc3067d45" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [RentedDays] &gt; 0 THEN 1 ELSE 0 END" msprop:Description="1 — у місяці була оренда" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element name="Contract_Facts" msprop:design-time-name="aa46222c-6d5e-49ff-9490-a0d8295809b3" msprop:QueryDefinition="SELECT c.ContractKey,
       YEAR(c.StartDate) * 10000 + MONTH(c.StartDate) * 100 + DAY(c.StartDate) AS StartDateKey,
       f.TenantKey,
       f.PremisesKey,
       c.MonthlyRent,
       c.Deposit,
       c.DurationMonths
FROM dbo.Dim_Contract AS c
LEFT JOIN (SELECT ContractKey, TenantKey, PremisesKey,
                  ROW_NUMBER() OVER (PARTITION BY ContractKey ORDER BY PeriodDateKey DESC) AS rn
           FROM dbo.Fact_Invoice) AS f
       ON f.ContractKey = c.ContractKey AND f.rn = 1" msprop:DbTableName="Contract_Facts" msprop:QueryBuilder="SpecificQueryBuilder" msprop:IsLogical="True" msprop:FriendlyName="Contract_Facts" msprop:TableType="View" msprop:Description="Договори як факти: дата початку, орендар і приміщення (з останнього рахунку), ставка, депозит, тривалість">
