                  <xs:element name="ContractStatus" msdata:ReadOnly="true" msprop:DbColumnName="ContractStatus" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [IsTerminated] = 1 THEN N'Розірваний достроково' WHEN [EffectiveEndDate] &lt; CAST(GETDATE() AS DATE) THEN N'Завершений' ELSE N'Діючий' END" msprop:design-time-name="0a4904ca-0e2e-422a-80d3-85cc8bbd46c9" msprop:Description="Стан договору на сьогодні" msprop:FriendlyName="ContractStatus" minOccurs="0">
