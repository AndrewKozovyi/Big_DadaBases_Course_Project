                  </xs:element>
                  <xs:element name="WorkingDayLabel" msdata:ReadOnly="true" msprop:DbColumnName="WorkingDayLabel" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [IsWorkingDay] = 1 THEN N'Робочий день' ELSE N'Неробочий день' END" msprop:design-time-name="9a6dfcb8-e3d3-49b1-874b-706604de6b5d" msprop:Description="Робочий / неробочий день" msprop:FriendlyName="WorkingDayLabel" minOccurs="0">
