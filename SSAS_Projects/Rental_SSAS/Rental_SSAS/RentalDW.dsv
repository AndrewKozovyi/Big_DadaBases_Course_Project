                  <xs:element name="StartDate" msprop:FriendlyName="StartDate" msprop:DbColumnName="StartDate" msprop:design-time-name="8c3b5e1c-c1fa-4856-a9d6-6ded41015d6a" type="xs:dateTime" />
                  <xs:element name="EndDate" msprop:FriendlyName="EndDate" msprop:DbColumnName="EndDate" msprop:design-time-name="588746e0-74a9-4f2f-899b-ee14e14b025a" type="xs:dateTime" />
