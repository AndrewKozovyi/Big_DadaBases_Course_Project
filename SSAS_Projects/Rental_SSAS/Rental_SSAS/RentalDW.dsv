                  <xs:element name="MonthlyRent" msprop:FriendlyName="MonthlyRent" msprop:DbColumnName="MonthlyRent" msprop:design-time-name="be0c278e-fd1a-43c8-92ef-75a02ea81fc7" type="xs:decimal" />
                  <xs:element name="Deposit" msprop:FriendlyName="Deposit" msprop:DbColumnName="Deposit" msprop:design-time-name="f996a1bc-9e32-4f64-9916-43fd5cd4ca24" type="xs:decimal" />
                  <xs:element name="PaymentDay" msprop:FriendlyName="PaymentDay" msprop:DbColumnName="PaymentDay" msprop:design-time-name="4c898c5c-7365-44ba-a8f4-a7cb8d1683de" type="xs:unsignedByte" />
                  <xs:element name="UpdatedAt" msprop:FriendlyName="UpdatedAt" msprop:DbColumnName="UpdatedAt" msprop:design-time-name="20d528fd-16ce-4bbd-b45f-c1b286f6307b" type="xs:dateTime" minOccurs="0" />
                  <xs:element name="ContractStatus" msprop:FriendlyName="ContractStatus" msprop:DbColumnName="ContractStatus" msprop:design-time-name="0a4904ca-0e2e-422a-80d3-85cc8bbd46c9" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE WHEN [IsTerminated] = 1 THEN N'Розірваний достроково' WHEN [EffectiveEndDate] &lt; CAST(GETDATE() AS DATE) THEN N'Завершений' ELSE N'Діючий' END" msprop:Description="Стан договору на сьогодні" msprop:IsLogical="True" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="DurationOrder" msprop:FriendlyName="DurationOrder" msprop:DbColumnName="DurationOrder" msprop:design-time-name="f94f63d5-3628-4ddb-b641-102103482e6b" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CASE [DurationCategory] WHEN N'До місяця' THEN 1 WHEN N'1–3 місяці' THEN 2 WHEN N'4–6 місяців' THEN 3 ELSE 4 END" msprop:Description="Порядок категорій тривалості" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                  <xs:element name="SignYear" msprop:FriendlyName="SignYear" msprop:DbColumnName="SignYear" msprop:design-time-name="c121823c-4314-463e-aec6-610444cebd45" msdata:ReadOnly="true" msprop:ComputedColumnExpression="YEAR([SignDate])" msprop:Description="Рік підписання" msprop:IsLogical="True" type="xs:int" minOccurs="0" />
                  <xs:element name="PeriodLabel" msprop:FriendlyName="PeriodLabel" msprop:DbColumnName="PeriodLabel" msprop:design-time-name="e6aad5da-e922-4ddb-ba01-dfd38e5c2f43" msdata:ReadOnly="true" msprop:ComputedColumnExpression="CONVERT(NVARCHAR(10), [StartDate], 104) + N' – ' + CONVERT(NVARCHAR(10), [EffectiveEndDate], 104)" msprop:Description="Фактичний період дії договору" msprop:IsLogical="True" minOccurs="0">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
