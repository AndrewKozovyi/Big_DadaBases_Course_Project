                  </xs:element>
                  <xs:element name="DayTypeKey" msdata:ReadOnly="true" msprop:DbColumnName="DayTypeKey" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [IsHoliday] = 1 THEN 3 WHEN [IsWeekend] = 1 THEN 2 ELSE 1 END" msprop:design-time-name="062196c6-0a9f-4395-b4d1-049351fd50b3" msprop:Description="Тип дня: 1 робочий, 2 вихідний, 3 свято" msprop:FriendlyName="DayTypeKey" type="xs:int" minOccurs="0" />
                  <xs:element name="DayTypeName" msdata:ReadOnly="true" msprop:DbColumnName="DayTypeName" msprop:IsLogical="True" msprop:ComputedColumnExpression="CASE WHEN [IsHoliday] = 1 THEN N'Святковий' WHEN [IsWeekend] = 1 THEN N'Вихідний' ELSE N'Робочий' END" msprop:design-time-name="0013c40f-f88a-4f72-a1d8-4642c1311de3" msprop:Description="Назва типу дня" msprop:FriendlyName="DayTypeName" minOccurs="0">
                    <xs:simpleType>
