                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="30" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="PremisesType" msprop:FriendlyName="PremisesType" msprop:DbColumnName="PremisesType" msprop:design-time-name="7247cb59-e4ff-40df-b5d9-256d9bb1d673">
                    <xs:simpleType>
