  <MdxScripts>
    <MdxScript dwd:design-time-name="e66b2567-5214-418e-803c-074509eb41b2">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
  MDX-скрипт куба «Оренда».
  CALCULATE обчислює агрегати з листових клітинок — не видаляти.
*/
CALCULATE;

/* ---------- 1. Середні значення та бізнес-метрики ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Середній рахунок]
 AS IIF([Measures].[Кількість рахунків] = 0, NULL, [Measures].[Сума рахунків] / [Measures].[Кількість рахунків]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Середні', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Середній платіж]
 AS IIF([Measures].[Кількість платежів] = 0, NULL, [Measures].[Сума платежів] / [Measures].[Кількість платежів]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Середні', ASSOCIATED_MEASURE_GROUP = 'Платежі';

CREATE MEMBER CURRENTCUBE.[Measures].[Середнє прострочення днів]
 AS IIF([Measures].[Прострочених рахунків] = 0, NULL,
        [Measures].[Днів прострочення] / [Measures].[Прострочених рахунків]),
FORMAT_STRING = "#,##0.0", VISIBLE = 1, DISPLAY_FOLDER = 'Середні', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Середнє запізнення оплати днів]
 AS IIF([Measures].[Платежів із запізненням] = 0, NULL,
        [Measures].[Днів запізнення] / [Measures].[Платежів із запізненням]),
FORMAT_STRING = "#,##0.0", VISIBLE = 1, DISPLAY_FOLDER = 'Середні', ASSOCIATED_MEASURE_GROUP = 'Платежі';

CREATE MEMBER CURRENTCUBE.[Measures].[Середня ставка оренди]
 AS IIF([Measures].[Кількість договорів] = 0, NULL,
        [Measures].[Сума орендних ставок] / [Measures].[Кількість договорів]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Середні', ASSOCIATED_MEASURE_GROUP = 'Договори';

CREATE MEMBER CURRENTCUBE.[Measures].[Середня тривалість договору міс]
 AS IIF([Measures].[Кількість договорів] = 0, NULL,
        [Measures].[Місяців оренди] / [Measures].[Кількість договорів]),
FORMAT_STRING = "#,##0.0", VISIBLE = 1, DISPLAY_FOLDER = 'Середні', ASSOCIATED_MEASURE_GROUP = 'Договори';

CREATE MEMBER CURRENTCUBE.[Measures].[Рівень оплати]
 AS IIF([Measures].[Сума рахунків] = 0, NULL, [Measures].[Сплачено] / [Measures].[Сума рахунків]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Частка боргу]
 AS IIF([Measures].[Сума рахунків] = 0, NULL, [Measures].[Борг] / [Measures].[Сума рахунків]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Частка прострочених рахунків]
 AS IIF([Measures].[Кількість рахунків] = 0, NULL,
        [Measures].[Прострочених рахунків] / [Measures].[Кількість рахунків]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Частка вчасних платежів]
 AS IIF([Measures].[Кількість платежів] = 0, NULL,
        1 - [Measures].[Платежів із запізненням] / [Measures].[Кількість платежів]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Платежі';

CREATE MEMBER CURRENTCUBE.[Measures].[Завантаженість]
 AS IIF([Measures].[Доступні дні] = 0, NULL, [Measures].[Орендовані дні] / [Measures].[Доступні дні]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Завантаженість';

/* % від загального: частка доходу поточного зрізу приміщень у доході всіх приміщень */
CREATE MEMBER CURRENTCUBE.[Measures].[Частка доходу від загального]
 AS IIF(([Measures].[Дохід від оренди], Root([Приміщення])) = 0, NULL,
        [Measures].[Дохід від оренди] / ([Measures].[Дохід від оренди], Root([Приміщення]))),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Завантаженість';

/* Бізнес-метрика: середній дохід з одного орендованого приміщення */
CREATE MEMBER CURRENTCUBE.[Measures].[Дохід на приміщення]
 AS IIF([Measures].[Орендованих приміщень] = 0, NULL,
        [Measures].[Сума рахунків] / [Measures].[Орендованих приміщень]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Показники', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

/* ---------- 2. Time Intelligence: YTD, PY, YoY, MoM ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Сума рахунків YTD]
 AS Aggregate(PeriodsToDate([Період].[Календар].[Рік], [Період].[Календар].CurrentMember), [Measures].[Сума рахунків]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Сплачено YTD]
 AS Aggregate(PeriodsToDate([Період].[Календар].[Рік], [Період].[Календар].CurrentMember), [Measures].[Сплачено]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Сума рахунків PY]
 AS ([Measures].[Сума рахунків], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Сума рахунків YoY]
 AS IIF(IsEmpty([Measures].[Сума рахунків]) OR IsEmpty([Measures].[Сума рахунків PY])
        OR [Measures].[Сума рахунків PY] = 0, NULL,
        ([Measures].[Сума рахунків] - [Measures].[Сума рахунків PY]) / [Measures].[Сума рахунків PY]),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

CREATE MEMBER CURRENTCUBE.[Measures].[Сума платежів MoM]
 AS IIF([Період].[Календар].CurrentMember.Level IS [Період].[Календар].[Місяць]
        AND NOT IsEmpty(([Measures].[Сума платежів], [Період].[Календар].CurrentMember.PrevMember))
        AND ([Measures].[Сума платежів], [Період].[Календар].CurrentMember.PrevMember) &lt;&gt; 0,
        ([Measures].[Сума платежів] - ([Measures].[Сума платежів], [Період].[Календар].CurrentMember.PrevMember))
          / ([Measures].[Сума платежів], [Період].[Календар].CurrentMember.PrevMember),
        NULL),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Платежі';

/* ---------- 3. Moving Average: ковзне середнє платежів за 3 періоди ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Платежі ковзне середнє 3]
 AS Avg(LastPeriods(3, [Період].[Календар].CurrentMember), [Measures].[Сума платежів]),
FORMAT_STRING = "#,##0.00", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Платежі';

CREATE MEMBER CURRENTCUBE.[Measures].[Завантаженість ковзна 3]
 AS IIF(Sum(LastPeriods(3, [Період].[Календар].CurrentMember), [Measures].[Доступні дні]) = 0, NULL,
        Sum(LastPeriods(3, [Період].[Календар].CurrentMember), [Measures].[Орендовані дні])
          / Sum(LastPeriods(3, [Період].[Календар].CurrentMember), [Measures].[Доступні дні])),
FORMAT_STRING = "Percent", VISIBLE = 1, DISPLAY_FOLDER = 'Динаміка', ASSOCIATED_MEASURE_GROUP = 'Завантаженість';

/* ---------- 4. Ranking: Топ-N та місце в рейтингу ---------- */
CREATE DYNAMIC SET CURRENTCUBE.[Топ-10 боржників]
 AS TopCount([Орендар].[Орендар].[Орендар].Members, 10, [Measures].[Борг]),
DISPLAY_FOLDER = 'Рейтинги';

CREATE DYNAMIC SET CURRENTCUBE.[Топ-10 приміщень за доходом]
 AS TopCount([Приміщення].[Приміщення].[Приміщення].Members, 10, [Measures].[Дохід від оренди]),
DISPLAY_FOLDER = 'Рейтинги';

CREATE SET CURRENTCUBE.[Приміщення за доходом]
 AS Order([Приміщення].[Приміщення].[Приміщення].Members, [Measures].[Дохід від оренди], BDESC),
DISPLAY_FOLDER = 'Рейтинги';

CREATE MEMBER CURRENTCUBE.[Measures].[Місце приміщення за доходом]
 AS IIF([Приміщення].[Приміщення].CurrentMember.Level.Ordinal = 0, NULL,
        Rank([Приміщення].[Приміщення].CurrentMember, [Приміщення за доходом])),
FORMAT_STRING = "#,##0", VISIBLE = 1, DISPLAY_FOLDER = 'Рейтинги', ASSOCIATED_MEASURE_GROUP = 'Завантаженість';

CREATE MEMBER CURRENTCUBE.[Measures].[Місце орендаря за боргом]
 AS IIF([Орендар].[Орендар].CurrentMember.Level.Ordinal = 0 OR [Measures].[Борг] = 0, NULL,
        Rank([Орендар].[Орендар].CurrentMember,
             Order(Filter([Орендар].[Орендар].[Орендар].Members, [Measures].[Борг] &gt; 0), [Measures].[Борг], BDESC))),
FORMAT_STRING = "#,##0", VISIBLE = 1, DISPLAY_FOLDER = 'Рейтинги', ASSOCIATED_MEASURE_GROUP = 'Рахунки';

/* ---------- 5. Обчислюваний член виміру ---------- */
CREATE MEMBER CURRENTCUBE.[Приміщення].[Група типів].[All].[Комерційна нерухомість]
 AS Aggregate({[Приміщення].[Група типів].&amp;[Офіси],
               [Приміщення].[Група типів].&amp;[Торгівля та послуги],
               [Приміщення].[Група типів].&amp;[Склад і виробництво]}),
VISIBLE = 1;
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="29d3336f-d9b7-40e8-ad2a-d078a17862e3">
      <ID>Payment Rate KPI</ID>
      <Name>Рівень оплати рахунків</Name>
      <Description>Частка сплаченої суми у виставлених рахунках. Ціль — 95 %, жовтий — від 85 %.</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Invoices</AssociatedMeasureGroupID>
      <Value>[Measures].[Рівень оплати]</Value>
      <Goal>0.95</Goal>
      <Status>CASE WHEN IsEmpty(KpiValue("Рівень оплати рахунків")) THEN NULL WHEN KpiValue("Рівень оплати рахунків") &gt;= KpiGoal("Рівень оплати рахунків") THEN 1 WHEN KpiValue("Рівень оплати рахунків") &gt;= 0.85 THEN 0 ELSE -1 END</Status>
      <Trend>IIF([Період].[Календар].CurrentMember.Level.Ordinal = 0 OR IsEmpty([Measures].[Рівень оплати]), NULL,
 IIF([Measures].[Рівень оплати] &gt; ([Measures].[Рівень оплати], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)), 1,
  IIF([Measures].[Рівень оплати] &lt; ([Measures].[Рівень оплати], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)), -1, 0)))</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="947c7816-bf91-47a9-a89c-c443c7ae261a">
      <ID>Occupancy KPI</ID>
      <Name>Завантаженість приміщень</Name>
      <Description>Частка орендованих днів від усіх днів. Ціль — 80 %, жовтий — від 60 %.</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Occupancy</AssociatedMeasureGroupID>
      <Value>[Measures].[Завантаженість]</Value>
      <Goal>0.8</Goal>
      <Status>CASE WHEN IsEmpty(KpiValue("Завантаженість приміщень")) THEN NULL WHEN KpiValue("Завантаженість приміщень") &gt;= KpiGoal("Завантаженість приміщень") THEN 1 WHEN KpiValue("Завантаженість приміщень") &gt;= 0.6 THEN 0 ELSE -1 END</Status>
      <Trend>IIF([Період].[Календар].CurrentMember.Level.Ordinal = 0 OR IsEmpty([Measures].[Завантаженість]), NULL,
 IIF([Measures].[Завантаженість] &gt; ([Measures].[Завантаженість], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)), 1,
  IIF([Measures].[Завантаженість] &lt; ([Measures].[Завантаженість], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)), -1, 0)))</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="7da24b5c-5b14-4ef6-a018-4c9f6c96152d">
      <ID>On Time KPI</ID>
      <Name>Своєчасність оплат</Name>
      <Description>Частка платежів без запізнення. Ціль — 90 %, жовтий — від 75 %.</Description>
      <DisplayFolder>KPI</DisplayFolder>
      <AssociatedMeasureGroupID>Payments</AssociatedMeasureGroupID>
      <Value>[Measures].[Частка вчасних платежів]</Value>
      <Goal>0.9</Goal>
      <Status>CASE WHEN IsEmpty(KpiValue("Своєчасність оплат")) THEN NULL WHEN KpiValue("Своєчасність оплат") &gt;= KpiGoal("Своєчасність оплат") THEN 1 WHEN KpiValue("Своєчасність оплат") &gt;= 0.75 THEN 0 ELSE -1 END</Status>
      <Trend>IIF([Період].[Календар].CurrentMember.Level.Ordinal = 0 OR IsEmpty([Measures].[Частка вчасних платежів]), NULL,
 IIF([Measures].[Частка вчасних платежів] &gt; ([Measures].[Частка вчасних платежів], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)), 1,
  IIF([Measures].[Частка вчасних платежів] &lt; ([Measures].[Частка вчасних платежів], ParallelPeriod([Період].[Календар].[Рік], 1, [Період].[Календар].CurrentMember)), -1, 0)))</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>