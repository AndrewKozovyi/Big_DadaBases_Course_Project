    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{D0994E03-0178-443C-A21E-6687C86993E0}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT i.InvoiceID, CAST(i.InvoiceNumber AS NVARCHAR(20)) AS InvoiceNumber, i.ContractID, c.TenantID, c.PremisesID, i.StatusID, CAST(i.PeriodMonth AS DATETIME) AS PeriodMonth, CAST(i.IssueDate AS DATETIME) AS IssueDate, CAST(i.DueDate AS DATETIME) AS DueDate, i.RentAmount, i.UtilitiesAmount, i.PenaltyAmount, CAST(i.TotalAmount AS DECIMAL(14,2)) AS TotalAmount FROM dbo.Invoice AS i JOIN dbo.Contract AS c ON c.ContractID = i.ContractID WHERE i.PeriodMonth &gt;= &quot; + &quot;DATEFROMPARTS(&quot; + (DT_WSTR,4)@[User::Year] + &quot;,1,1)&quot; + &quot; AND i.PeriodMonth &lt; &quot; + &quot;DATEFROMPARTS(&quot; + (DT_WSTR,4)(@[User::Year] + 1) + &quot;,1,1)&quot; + &quot; AND NOT EXISTS (SELECT 1 FROM RentalDW.dbo.Fact_Invoice AS f WHERE f.InvoiceID = i.InvoiceID) ORDER BY i.InvoiceID&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlFactInvoice">
      <DTS:VariableValue
        DTS:DataType="8">SELECT i.InvoiceID, CAST(i.InvoiceNumber AS NVARCHAR(20)) AS InvoiceNumber, i.ContractID, c.TenantID, c.PremisesID, i.StatusID, CAST(i.PeriodMonth AS DATETIME) AS PeriodMonth, CAST(i.IssueDate AS DATETIME) AS IssueDate, CAST(i.DueDate AS DATETIME) AS DueDate, i.RentAmount, i.UtilitiesAmount, i.PenaltyAmount, CAST(i.TotalAmount AS DECIMAL(14,2)) AS TotalAmount FROM dbo.Invoice AS i JOIN dbo.Contract AS c ON c.ContractID = i.ContractID WHERE i.PeriodMonth &gt;= DATEFROMPARTS(2021,1,1) AND i.PeriodMonth &lt; DATEFROMPARTS(2022,1,1) AND NOT EXISTS (SELECT 1 FROM RentalDW.dbo.Fact_Invoice AS f WHERE f.InvoiceID = i.InvoiceID) ORDER BY i.InvoiceID</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{AD84A66F-2B0A-4DE4-8721-C58C06F82F50}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT p.PaymentID, p.InvoiceID, CAST(p.PaymentDate AS DATETIME) AS PaymentDate, p.Amount, CAST(i.DueDate AS DATETIME) AS DueDate, i.ContractID, c.TenantID, c.PremisesID FROM dbo.Payment AS p JOIN dbo.Invoice AS i ON i.InvoiceID = p.InvoiceID JOIN dbo.Contract AS c ON c.ContractID = i.ContractID WHERE p.PaymentID &gt; &quot; + (DT_WSTR,12)@[User::LastPaymentID]"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlFactPayment">
      <DTS:VariableValue
        DTS:DataType="8">SELECT p.PaymentID, p.InvoiceID, CAST(p.PaymentDate AS DATETIME) AS PaymentDate, p.Amount, CAST(i.DueDate AS DATETIME) AS DueDate, i.ContractID, c.TenantID, c.PremisesID FROM dbo.Payment AS p JOIN dbo.Invoice AS i ON i.InvoiceID = p.InvoiceID JOIN dbo.Contract AS c ON c.ContractID = i.ContractID WHERE p.PaymentID &gt; 0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{10CB6AA1-101F-4F67-AF5E-8F5FE4FAB4C9}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT p.InvoiceID, CAST(p.Amount AS FLOAT) AS Amount, CAST(p.PaymentDate AS DATETIME) AS PaymentDate FROM dbo.Payment AS p JOIN dbo.Invoice AS i ON i.InvoiceID = p.InvoiceID WHERE i.PeriodMonth &gt;= &quot; + &quot;DATEFROMPARTS(&quot; + (DT_WSTR,4)@[User::Year] + &quot;,1,1)&quot; + &quot; AND i.PeriodMonth &lt; &quot; + &quot;DATEFROMPARTS(&quot; + (DT_WSTR,4)(@[User::Year] + 1) + &quot;,1,1)&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SqlInvoicePayments">
      <DTS:VariableValue
        DTS:DataType="8">SELECT p.InvoiceID, CAST(p.Amount AS FLOAT) AS Amount, CAST(p.PaymentDate AS DATETIME) AS PaymentDate FROM dbo.Payment AS p JOIN dbo.Invoice AS i ON i.InvoiceID = p.InvoiceID WHERE i.PeriodMonth &gt;= DATEFROMPARTS(2021,1,1) AND i.PeriodMonth &lt; DATEFROMPARTS(2022,1,1)</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{1091A96A-1C7E-4D4E-A4F9-0616758A1F1C}"
