                <component
                  refId="Package\Факти\Fact_Occupancy\Дні оренди по місяцях"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Дні оренди по місяцях"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH Bounds AS (
    SELECT MIN(DATEFROMPARTS(YEAR(StartDate), MONTH(StartDate), 1))      AS FirstMonth,
           DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)          AS LastMonth
    FROM dbo.Contract
),
N AS (
    SELECT TOP (600) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n FROM sys.all_objects
),
Months AS (
    SELECT DATEADD(MONTH, N.n, b.FirstMonth) AS MonthStart
    FROM Bounds AS b
    JOIN N ON DATEADD(MONTH, N.n, b.FirstMonth) &lt;= b.LastMonth
)
SELECT
    p.PremisesID,
    CAST(m.MonthStart AS DATETIME) AS MonthStart,
    CAST(ISNULL(d.Days, 0) AS BIGINT) AS RentedDays,
    CAST(CASE WHEN c.ContractID IS NULL THEN 0 ELSE 1 END AS BIGINT) AS ContractFlag,
    CAST(ISNULL(c.MonthlyRent * d.Days / DAY(EOMONTH(m.MonthStart)), 0) AS FLOAT) AS RentIncome
FROM dbo.Premises AS p
CROSS JOIN Months AS m
LEFT JOIN dbo.Contract AS c
       ON c.PremisesID = p.PremisesID
      AND c.StartDate &lt;= EOMONTH(m.MonthStart)
      AND COALESCE(c.TerminationDate, c.EndDate) &gt;= m.MonthStart
OUTER APPLY (
    SELECT DATEDIFF(DAY,
               CASE WHEN c.StartDate &gt; m.MonthStart THEN c.StartDate ELSE m.MonthStart END,
               CASE WHEN COALESCE(c.TerminationDate, c.EndDate) &lt; EOMONTH(m.MonthStart)
                    THEN COALESCE(c.TerminationDate, c.EndDate) ELSE EOMONTH(m.MonthStart) END) + 1 AS Days
    WHERE c.ContractID IS NOT NULL
) AS d</property>
